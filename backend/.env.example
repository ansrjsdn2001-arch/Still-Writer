# Supabase Dashboard의 Connect > Session pooler에서 확인한 값을 입력합니다.
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSL_MODE=require

# Supabase 무료 인스턴스용 보수적인 연결 풀 기본값입니다.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0

# Gmail SMTP 설정입니다.
# MAIL_PASSWORD에는 Gmail 계정 비밀번호가 아니라 Google 계정에서 발급한 앱 비밀번호를 넣어야 합니다.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=stillwriter01@gmail.com
MAIL_PASSWORD=
MAIL_FROM=stillwriter01@gmail.com
EMAIL_VERIFICATION_CODE_LENGTH=6
EMAIL_VERIFICATION_EXPIRES_MINUTES=3

# 인증 토큰 설정입니다. 운영 환경에서는 JWT_SECRET을 충분히 긴 랜덤 문자열로 바꿔야 합니다.
JWT_SECRET=
ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_HOURS=12
REFRESH_TOKEN_COOKIE_SECURE=false

# Google OAuth 로그인 설정입니다.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth/google/callback
